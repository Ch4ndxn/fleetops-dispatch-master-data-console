# VROOM route-optimisation service for the "VROOM Routes" tab.
# On Render: New → Web Service → this repo → Language: Docker, Root Directory: vroom.
# No build or start command needed — the official image already runs vroom-express on port 3000.
FROM ghcr.io/vroom-project/vroom-docker:v1.15.0
ENV VROOM_ROUTER=osrm
EXPOSE 3000
